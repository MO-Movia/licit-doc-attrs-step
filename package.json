{
  "name": "@modusoperandi/licit-doc-attrs-step",
  "version": "1.0.5",
  "license": "MIT",
  "type": "module",
  "subversion": "1",
  "description": "Module that extend Step, overriding the apply, invert, map, getMap and fromJSON methods, and registering your class with a unique JSON-serialization identifier using Step.jsonID.",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/MO-Movia/licit-doc-attrs-step"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=23",
    "test": "jest --coverage",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "ci:build": "tsc --build --clean && tsc --build && copyfiles package.json LICENSE .npmignore dist",
    "ci:bom": "cyclonedx-npm --ignore-npm-errors --short-PURLs --output-format XML --output-file dist/bom.xml",
    "debug": "node --debug-brk --inspect ./node_modules/.bin/jest -i",
    "verify": "npm run lint -- --fix && npm run test:coverage && npm run ci:build && echo 'All Tests Passed!'"
  },
  "peerDependencies": {
    "prosemirror-keymap": "^1.2.0",
    "prosemirror-model": "^1.19.4",
    "prosemirror-state": "^1.4.2",
    "prosemirror-transform": "^1.7.0",
    "prosemirror-view": "^1.27.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.0.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@types/jest": "^30.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.35.0",
    "@modusoperandi/eslint-config": "^3.0.2",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jest-junit": "^16.0.0",
    "jest-prosemirror": "^3.0.1",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "libxmljs2": "^1.0.0"
  },
  "importSort": {
    ".js": {
      "parser": "babylon",
      "style": "module-grouping"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "!(*test|*.setup).ts": [
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}